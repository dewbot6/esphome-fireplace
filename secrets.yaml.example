# ESPHome Secrets Configuration
# Copy this file to secrets.yaml and fill in your actual values
# DO NOT commit secrets.yaml to git!

# =============================
# OpenThread Configuration
# =============================
# Thread TLV (Thread Link Layer Dataset) in hex format
# Generate this using your Thread border router or Thread network setup tool
# Example format (replace with your actual TLV data):
thread_tlv: "0e080000000000010000000300000f35060004001fffe00208dead00beef00cafe0708fddead00beef00cafe0510dead00beef00cafe0003000f35060004001fffe0"

# =============================
# WiFi Configuration (Alternative to OpenThread)
# =============================
# Uncomment these if using WiFi instead of OpenThread
# wifi_ssid: "YourWiFiNetworkName"
# wifi_password: "YourWiFiPassword"

# =============================
# Additional Secrets (if needed)
# =============================
# Add any other secrets your configuration might need here
